{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"$(git rev-parse --show-toplevel)/scripts/Invoke-DocumentationReviewHook.ps1\"",
            "commandWindows": "pwsh -NoProfile -NonInteractive -Command \"& (Join-Path (git rev-parse --show-toplevel) 'scripts/Invoke-DocumentationReviewHook.ps1')\"",
            "timeout": 15,
            "statusMessage": "Preparing documentation review"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/impeccable/scripts/impeccable\" ] || \".agents/skills/impeccable/scripts/impeccable\" hook",
            "commandWindows": "pwsh -NoProfile -NonInteractive -Command \"if (Test-Path (Join-Path (git rev-parse --show-toplevel) '.agents/skills/impeccable/scripts/impeccable.cmd')) { & (Join-Path (git rev-parse --show-toplevel) '.agents/skills/impeccable/scripts/impeccable.cmd') hook }\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"$(git rev-parse --show-toplevel)/scripts/Invoke-DocumentationReviewHook.ps1\"",
            "commandWindows": "pwsh -NoProfile -NonInteractive -Command \"& (Join-Path (git rev-parse --show-toplevel) 'scripts/Invoke-DocumentationReviewHook.ps1')\"",
            "timeout": 15,
            "statusMessage": "Reviewing documentation impact"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/impeccable/scripts/impeccable\" ] || \".agents/skills/impeccable/scripts/impeccable\" hook",
            "commandWindows": "pwsh -NoProfile -NonInteractive -Command \"if (Test-Path (Join-Path (git rev-parse --show-toplevel) '.agents/skills/impeccable/scripts/impeccable.cmd')) { & (Join-Path (git rev-parse --show-toplevel) '.agents/skills/impeccable/scripts/impeccable.cmd') hook }\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
