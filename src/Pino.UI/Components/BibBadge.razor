<span class="bib-badge" data-compact="@(Compact ? "true" : "false")" data-long="@(Number.Length > 4 ? "true" : "false")" role="img" aria-label="@(Number.Length > 0 ? $"Bib {Number}" : "No bib assigned")"><span class="bib-label" aria-hidden="true">Bib</span><strong aria-hidden="true">@(Number.Length > 0 ? Number : "—")</strong></span>
