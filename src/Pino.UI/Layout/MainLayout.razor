@inherits LayoutComponentBase

<div class="page">
    <a class="account-skip" data-enhance-nav="false" href="@(Navigation.Uri.Split('#')[0] + "#account-content")">Skip to content</a>
    <header class="app-masthead">
        <div class="app-width app-masthead-inner">
            <NavMenu />
        </div>
    </header>

    <main id="account-content" class="app-width app-content content-container" tabindex="-1">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <div class="error-content">
        <span>An unhandled error has occurred.</span>
        <a href="." class="reload">Reload</a>
        <button type="button" class="dismiss">Dismiss</button>
    </div>
</div>
