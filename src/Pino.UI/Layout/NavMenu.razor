@implements IDisposable

@inject NavigationManager NavigationManager

<div class="site-navigation">
    <a class="site-name" href="">Pino<span aria-hidden="true">.</span></a>

    <nav aria-label="Main navigation">
        <ul class="navigation-links">
            <li><NavLink href="" Match="NavLinkMatch.All">Club workspace</NavLink></li>

            <AuthorizeView>
                <Authorized>
                    <li><NavLink href="Account/Manage">Account</NavLink></li>
                    <li>
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@_currentUrl" />
                            <button type="submit">Logout</button>
                        </form>
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li><NavLink href="Account/Register">Register</NavLink></li>
                    <li><NavLink href="Account/Login">Login</NavLink></li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>
    </nav>
</div>
