@inherits LayoutComponentBase

<div class="tryout-shell">
    <a class="skip-link" href="#tryout-content">Skip to tryout</a>
    <header class="club-header">
        <a class="wordmark" href="/" aria-label="Pino home">Pino<span aria-hidden="true">.</span></a>
        <div class="club-name">Northside FC <span>Club workspace</span></div>
        <span class="sample-label">Sample data</span>
        <a class="account-link" href="Account/Manage">Account</a>
    </header>
    <main id="tryout-content" tabindex="-1">@Body</main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something interrupted this sample session. Copy any unsaved notes before reloading.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss">Dismiss</button>
</div>
