<section aria-labelledby="profile-heading">
    <h2 id="profile-heading">@(Profile.IsComplete ? "Edit your profile" : "Complete your profile")</h2>
    <p class="muted">Help club staff recognize you. Your photo is shared with your club and administrators reviewing your request.</p>
    <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="club-profile">
        <DataAnnotationsValidator />
        <fieldset disabled="@(!RendererInfo.IsInteractive || Busy)" class="profile-fields">
            <div class="name-fields">
                <div class="form-field"><label for="first-name">First name</label><InputText id="first-name" autocomplete="given-name" maxlength="80" @bind-Value="_model.FirstName" /><ValidationMessage For="() => _model.FirstName" /></div>
                <div class="form-field"><label for="last-name">Last name</label><InputText id="last-name" autocomplete="family-name" maxlength="80" @bind-Value="_model.LastName" /><ValidationMessage For="() => _model.LastName" /></div>
            </div>
            <PhotoEditor InputId="profile-photo" Label="Profile photo" SavedPhotoUrl="Profile.PhotoUrl" Disabled="Busy" CroppedPhotoChanged="value => _model.CroppedPhoto = value" PendingChanged="value => _photoPending = value" />
            @if (_error is not null) { <p class="notice" data-kind="error" role="alert">@_error</p> }
            @if (_photoPending) { <p class="muted">Use this crop to review your photo before saving the profile.</p> }
            <div class="actions">
                <button class="primary-action" type="submit" disabled="@_photoPending">@(Busy ? "Saving profile…" : "Save profile")</button>
                @if (Profile.IsComplete) { <button class="text-action" type="button" @onclick="Cancel">Cancel</button> }
            </div>
        </fieldset>
    </EditForm>
</section>
