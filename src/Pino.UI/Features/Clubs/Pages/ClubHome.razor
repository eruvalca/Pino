@page "/clubs/{ClubId:guid}"
@attribute [Authorize]
@rendermode InteractiveAuto
@layout ClubLayout
@inherits Pino.UI.Features.Sporting.Services.SportPageBase
@using Pino.UI.Features.Sporting.Components

<PageTitle>@(Membership?.Club.Name ?? "Club workspace") · Pino</PageTitle>
<SportFrame Membership="Membership" Busy="Busy" Failed="Failed" Message="@Message" MessageKind="@MessageKind" Reload="ReloadAsync">
    <header class="sport-heading">
        <div><h1>@Membership?.Club.Name</h1><p>@Membership?.Club.Sport · @Membership?.Club.City · Your club notebook</p></div>
        <a class="primary-action" href="@($"/clubs/{ClubId}/seasons")">Plan a season</a>
    </header>
    @if (_overview is not null)
    {
        @if (_overview.Seasons.Count == 0)
        {
            <section class="sport-empty"><h2>Start with your players and a season</h2><p>Add your club's player catalog, create a season and its teams, then open a tryout to record notes and decisions. Each season keeps its own placement history.</p><a class="secondary-action" href="@($"/clubs/{ClubId}/players")">Add your first players</a></section>
        }
        else
        {
            <section><h2>Tryouts</h2>
                @if (_overview.Tryouts.Count == 0) { <p class="muted">Your season is ready for a tryout. Open Seasons &amp; teams to set the date and add a roster.</p> }
                <ul class="record-list">
                @foreach (var tryout in _overview.Tryouts.Where(value => _overview.Seasons.Any(season => season.Id == value.SeasonId && !season.Archived)))
                {
                    <li class="record-row" @key="tryout.Id"><div><h3><a href="@($"/clubs/{ClubId}/tryouts/{tryout.Id}")">@tryout.Name</a></h3><p class="muted">@_overview.Seasons.First(season => season.Id == tryout.SeasonId).Name · @tryout.Date.ToString("MMM d, yyyy")</p></div><span class="decision-badge" data-kind="@(tryout.Complete ? "placed" : "awaiting")">@Pino.UI.Features.Sporting.Services.SportLabels.Progress(tryout)</span></li>
                }
                </ul>
                <a href="@($"/clubs/{ClubId}/seasons")">View all seasons, teams and archived tryouts</a>
            </section>
        }
        <section class="sport-section"><h2>Club records</h2><ul class="record-list">
            <li class="record-row"><div><h3><a href="@($"/clubs/{ClubId}/players")">Player catalog</a></h3><p class="muted">Player details, CSV import and placement history across seasons.</p></div></li>
            @if (Membership?.Role == ClubRole.Administrator) { <li class="record-row"><div><h3><a href="@($"/clubs/{ClubId}/people")">People &amp; requests</a></h3><p class="muted">Review join requests and manage your club's coaches and administrators.</p></div></li> }
        </ul></section>
    }
</SportFrame>
