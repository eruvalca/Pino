@page "/clubs/{ClubId:guid}/people"
@attribute [Authorize]
@rendermode InteractiveAuto
@layout ClubLayout

<PageTitle>People · Pino</PageTitle>
<ClubPageShell Club="_data?.Club" CanManagePeople="@(_data is not null)">
<article class="people-sheet" aria-busy="@(IsBusy ? "true" : "false")">
    <a href="@($"/clubs/{ClubId}")">Back to club</a>
    <h1 @ref="_heading" tabindex="-1">People</h1>
    @if (_data is not null)
    {
        <nav class="workflow-actions" aria-label="Staff administration"><a class="primary-action" href="@($"/clubs/{ClubId}/invitations")">Staff invitations</a><a class="secondary-action" href="@($"/clubs/{ClubId}/emails")">Email delivery</a><a class="secondary-action" href="@($"/clubs/{ClubId}/settings")">Club details</a></nav>
    }
    @if (_data is not null) { <p class="club-identity">@_data.Club.Name · @_data.Club.City, @UsStates.All[_data.Club.State]</p> }
    @if (_message is not null) { <p class="notice" data-kind="@_kind" role="status">@_message</p> }
    <nav class="people-views" aria-label="People views"><button class="text-action" aria-current="@(_requests ? "page" : null)" @onclick="ShowRequestsAsync" disabled="@IsBusy">Requests</button><button class="text-action" aria-current="@(!_requests ? "page" : null)" @onclick="ShowMembersAsync" disabled="@IsBusy">Members</button><button class="text-action" @onclick="RefreshQuietlyAsync" disabled="@IsBusy">Refresh</button></nav>
    @if (_data is null)
    {
        <p>@(_failed ? "People are unavailable. Check your club access or try refreshing." : "Loading people…")</p>
        <a href="/club/access">Your club access</a>
    }
    else
    {
        @if (_loading) { <p role="status">Loading people…</p> }
        <h2>@(_requests ? "Membership requests" : "Club members")</h2>
        <p class="muted">@(_requests ? "Approve people you recognize to give them coach access." : "Administrators manage access. Coaches work with the club. Keep at least one administrator.")</p>
        @if (_confirmation is not null)
        {
            <section class="people-confirm" aria-labelledby="confirmation-heading">
                <h3 id="confirmation-heading" tabindex="-1" @ref="_confirmHeading">@_confirmation.Title</h3>
                <p>@_confirmation.Description</p>
                <div class="actions"><button class="primary-action" @onclick="ConfirmAsync" disabled="@IsBusy">@_confirmation.Action</button><button class="secondary-action" @onclick="CancelConfirmationAsync" disabled="@IsBusy">Cancel</button></div>
            </section>
        }
        @if (_data.People.Count == 0)
        {
            <p class="empty-people">@(_requests ? "No requests are waiting for review." : "No members on this page.")</p>
        }
        <ul class="people-list">
            @foreach (var person in _data.People)
            {
                <li @key="person.UserId">
                    <img src="@person.PhotoUrl" width="56" height="56" alt="" />
                    <div class="person-identity"><h3>@person.FirstName @person.LastName</h3><p>@(_requests ? $"Requested {person.Since.ToLocalTime():g}" : person.Role.ToString())</p></div>
                    <div class="person-actions">
                        @if (_requests)
                        {
                            <button class="primary-action" disabled="@IsBusy" @onclick="() => ApproveAsync(person)">Approve as coach</button>
                            <button class="text-action" disabled="@IsBusy" @onclick="() => Deny(person)">Deny request</button>
                        }
                        else
                        {
                            <button class="secondary-action" disabled="@IsBusy" @onclick="() => ChangeRole(person)">@(person.Role == ClubRole.Coach ? "Make administrator" : "Make coach")</button>
                            <button class="text-action" disabled="@IsBusy" @onclick="() => Remove(person)">Remove from club</button>
                        }
                    </div>
                </li>
            }
        </ul>
        @if (_data.Page > 0 || _data.HasMore)
        {
            <nav class="actions" aria-label="People pages"><button class="secondary-action" disabled="@(IsBusy || _page == 0)" @onclick="PreviousAsync">Previous</button><span>Page @(_page + 1)</span><button class="secondary-action" disabled="@(IsBusy || !_data.HasMore)" @onclick="NextAsync">Next</button></nav>
        }
    }
</article>
<AccessWatch Tick="RefreshQuietlyAsync" />
</ClubPageShell>
