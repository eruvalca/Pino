<EditForm Model="_model" OnValidSubmit="SaveAsync" class="sport-form" FormName="TeamEditor">
    <DataAnnotationsValidator /><ValidationSummary />
    <fieldset disabled="@(Busy || !RendererInfo.IsInteractive)">
        <div class="form-field"><label for="team-name">Team name</label><InputText id="team-name" maxlength="120" @bind-Value="_model.Name" /></div>
<div class="form-field"><label for="team-year">Earliest graduation year</label><InputNumber id="team-year" min="2000" max="2100" @bind-Value="_model.GraduationYear" /><p class="muted">Players must graduate in this year or later. For example, 2030 allows 2030 and 2031, but not 2029.</p></div>
@if (_model.Revision > 0) { <label class="checkbox-field"><InputCheckbox @bind-Value="_model.Archived" /> Archive team (current players must be moved first)</label> }
        <div class="actions"><button class="primary-action" type="submit">@(Busy ? "Saving…" : "Save team")</button><button class="text-action" type="button" @onclick="Cancel">Cancel</button></div>
    </fieldset>
</EditForm>
