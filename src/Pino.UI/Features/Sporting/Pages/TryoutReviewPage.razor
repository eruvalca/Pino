@page "/clubs/{ClubId:guid}/tryouts/{TryoutId:guid}/review"
@attribute [Authorize]
@rendermode InteractiveAuto
@layout ClubLayout
@inherits SportPageBase

<PageTitle>@(_review?.Tryout.Name ?? "Tryout review") · Pino</PageTitle>
<SportFrame Membership="Membership" Busy="Busy" Failed="Failed" Message="@Message" MessageKind="@MessageKind" Reload="ReloadAsync">
    @if (_review is { } review)
    {
        <p><a href="@($"/clubs/{ClubId}/seasons/{review.Season.Id}/review")">@review.Season.Name · Season review</a></p>
        <header class="sport-heading"><div><h1>@review.Tryout.Name</h1><p>@review.Tryout.Date.ToString("MMM d, yyyy") · Review results</p></div><span class="decision-badge" data-kind="@(review.Tryout.Closed ? "placed" : "awaiting")">@(review.Tryout.Closed ? "Closed" : "Open")</span></header>
        <nav class="workflow-actions" aria-label="Review actions"><a class="secondary-action" href="@($"/clubs/{ClubId}/tryouts/{TryoutId}")">Open player notebooks</a><button class="text-action" disabled="@Disabled" @onclick="ReloadAsync">Reload results</button></nav>
        <WorkflowProgress Steps="_steps" Current="Step" Label="Tryout closeout progress" />
        <h2 @ref="_stepHeading" tabindex="-1">@_steps[Step]</h2>
        @if (review.Season.Archived) { <p class="notice" data-kind="information">This season is archived. Reopen it in season setup before changing the tryout's state.</p> }
        @if (!_confirmationStep)
        {
        @if (review.Closeouts.Count > 0)
        {
            <div class="form-field edition-picker"><label for="closeout-edition">Saved results</label><select id="closeout-edition" @bind="_editionId" @bind:after="ChangeEdition"><option value="">Current tryout decisions</option>@foreach (var edition in review.Closeouts) { <option value="@edition.Id">Closed @edition.ClosedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm:ss tt") · @edition.ClosedBy</option> }</select></div>
        }
        @if (Edition is { } closed)
        {
            <section class="closeout-receipt" aria-labelledby="receipt-heading" @key="closed.Id"><div class="receipt-mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28"><path d="m5 12 4 4L19 6" fill="none" stroke="currentColor" stroke-width="2" /></svg></div><div><h2 id="receipt-heading">Results recorded</h2><p><strong>@closed.TryoutName</strong> · @closed.SeasonName · @closed.TryoutDate.ToString("MMM d, yyyy")</p><p>@closed.Results.Count players · Closed by <span class="staff-attribution"><StaffAvatar Name="@closed.ClosedBy" PhotoUrl="closed.ClosedByPhotoUrl" Compact="true" /><span>@closed.ClosedBy</span></span> on <time datetime="@closed.ClosedAt.ToString("O")">@closed.ClosedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</time></p><p class="muted">These are the names, bibs and results saved when the tryout closed. Players may have changed teams since then.</p>
                @if (closed.ReopenedAt is { } reopened) { <p><strong>Reopened</strong> by <span class="staff-attribution"><StaffAvatar Name="@closed.ReopenedBy" PhotoUrl="closed.ReopenedByPhotoUrl" Compact="true" /><span>@closed.ReopenedBy</span></span> on @reopened.ToLocalTime().ToString("MMM d, yyyy · h:mm tt"): @closed.ReopenReason</p> }
                @if (closed.ErasedPlayers > 0) { <p class="notice" data-kind="information">Personal data for @closed.ErasedPlayers player(s) was permanently deleted from these saved results.</p> }
            </div></section>
        }
        else if (review.Tryout.Closed)
        {
            <section class="review-readiness"><h2>Current tryout decisions</h2><p>This tryout is closed. This list shows current player names. Choose saved results above to see names and results from when it closed.</p></section>
        }
        else
        {
            <section class="review-readiness"><h2>@(review.Tryout.Complete ? "Ready for your final review" : "Decisions still to record")</h2><p>@review.Tryout.Decided of @review.Tryout.Players players have a decision. @(review.Tryout.Complete ? "Check the results below, then close the tryout to save them." : "Each included player needs a final decision: Placed, Withdrawn, Not selected or Did not attend.")</p></section>
        }
        <div class="actions"><a class="secondary-action" href="@ExportUrl" download data-enhance-nav="false">@(Edition is null ? "Download current results (CSV)" : "Download saved results (CSV)")</a><a href="@($"/clubs/{ClubId}/tryouts/{TryoutId}/print")">Print player &amp; bib list</a></div>
        <p class="muted">The download includes every player in the selected results. The filters below only change what you see here.</p>
        <div class="sport-toolbar"><div class="form-field"><label for="result-search">Find a result</label><input id="result-search" type="search" disabled="@Disabled" @bind="_query" @bind:event="oninput" @bind:after="ResetPage" placeholder="Player, bib or team" /></div><div class="form-field"><label for="result-decision">Result</label><select id="result-decision" disabled="@Disabled" @bind="_decision" @bind:after="ResetPage"><option value="">All results</option>@foreach (var kind in Enum.GetValues<DecisionKind>()) { <option value="@kind">@SportLabels.Decision(kind)</option> }</select></div></div>
        <p class="muted" role="status">@Results.Count() of @(Edition?.Results.Count ?? review.Results.Count) results match</p>
        <RosterPager Count="Results.Count()" Page="_page" PageChanged="ChangePage" Label="Result pages" Disabled="Disabled" />
        <ul class="result-ledger">@foreach (var result in Results.Skip(_page * 50).Take(50))
        {
            <li @key="result.PlayerId"><span class="result-bib"><span class="result-bib-label">Bib </span>@(result.Bib.Length > 0 ? result.Bib : "—")</span><div><a href="@($"/clubs/{ClubId}/players/{result.PlayerId}")">@result.FullName</a><small>Class of @result.GraduationYear</small></div><div class="result-outcome"><span class="decision-badge" data-kind="@SportLabels.Kind(result.Decision)">@SportLabels.Decision(result.Decision)</span>@if (result.TeamName is not null) { <span>@result.TeamName</span> }</div></li>
        }</ul>
        @if (!Results.Any()) { <p>@(review.Results.Count == 0 ? "No players enrolled yet. Add players from the notebooks to begin." : "No results match these filters.")</p> }
        @if (!review.Tryout.Closed && _editionId is null)
        {
            <button type="button" class="primary-action" disabled="@(Disabled || review.Season.Archived || !review.Tryout.Complete)" @onclick="ReviewCloseout">Continue to confirmation</button>
        }
        }
        @if (_confirmationStep && !review.Tryout.Closed && _editionId is null)
        {
            <p>Save the current results for <strong>@review.Tryout.Name</strong>, with all @review.Tryout.Players players included.</p>
            <ul>@foreach (var group in review.Results.GroupBy(value => value.Decision)) { <li>@group.Count() · @SportLabels.Decision(group.Key)</li> }</ul>
            <form id="close-tryout" class="closeout-action sport-form" @onsubmit="CloseAsync" @onsubmit:preventDefault><fieldset class="sport-fields" disabled="@(Disabled || review.Season.Archived || !review.Tryout.Complete)"><legend>Close this tryout</legend><p>Closing stops changes to players, bibs, decisions, notes and tryout details. Staff can reopen it with a reason. Players keep their current teams.</p><label class="closeout-confirm"><input type="checkbox" @bind="_confirmed" /> I have reviewed all @review.Tryout.Players player results.</label><button class="primary-action" type="submit" disabled="@(!_confirmed)">Close tryout &amp; record results</button><button type="button" class="secondary-action" @onclick="BackToResults">Back to results</button></fieldset></form>
        }
        else if (review.Tryout.Closed && Edition is { ReopenedAt: null })
        {
            <details class="closeout-action"><summary>Reopen for a correction</summary><form class="sport-form" @onsubmit="ReopenAsync" @onsubmit:preventDefault><fieldset class="sport-fields" disabled="@(Disabled || review.Season.Archived)"><p>Saved results stay available. Reopening lets staff make changes again. It does not change any player's team.</p><div class="form-field"><label for="reopen-reason">Reason for reopening</label><textarea id="reopen-reason" maxlength="1000" rows="3" required @bind="_reason"></textarea></div><button type="submit" class="secondary-action">Reopen tryout</button></fieldset></form></details>
        }
    }
</SportFrame>
