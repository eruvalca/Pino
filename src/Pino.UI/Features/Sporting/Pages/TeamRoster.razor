@page "/clubs/{ClubId:guid}/teams/{TeamId:guid}"
@attribute [Authorize]
@rendermode InteractiveAuto
@layout ClubLayout
@inherits SportPageBase

<PageTitle>@(_detail?.Team.Name ?? "Team roster") · Pino</PageTitle>
<SportFrame Membership="Membership" Busy="Busy" Failed="Failed" Message="@Message" MessageKind="@MessageKind" Reload="ReloadAsync">
    @if (_detail is { } detail)
    {
        <p><a href="@($"/clubs/{ClubId}/seasons/{detail.Season.Id}")">@detail.Season.Name</a></p>
        <header class="sport-heading"><div><h1>@detail.Team.Name</h1><p>Graduation @detail.Team.GraduationYear or later · @(detail.Season.Archived ? "Archived season" : "Current season roster")</p></div><button class="secondary-action" disabled="@Disabled" @onclick="ReloadAsync">Refresh roster</button></header>
        <h2>@detail.Members.Count players</h2>
        @if (detail.Members.Count == 0) { <p class="muted">No current placements on this team. Place players through a tryout in this season.</p> }
        <ul class="record-list">@foreach (var player in detail.Members) { <li class="record-row" @key="player.Id"><div><h3><a href="@($"/clubs/{ClubId}/players/{player.Id}")">@player.FullName</a></h3><p class="muted">Class of @player.GraduationYear</p></div><span>@player.Position</span></li> }</ul>
        <section class="sport-section"><h2>Placement history</h2><p class="muted">Decisions involving this team, including revisions after players moved. Player records show the full history.</p>
            @if (detail.History.Count == 0) { <p>No placements recorded yet.</p> }
            <ul class="record-history">@foreach (var entry in detail.History) { <li @key="entry.Decision.Id"><strong><a href="@($"/clubs/{ClubId}/players/{entry.Player.Id}")">@entry.Player.FullName</a> · @SportLabels.Decision(entry.Decision.Kind)@(entry.Decision.Team is null ? "" : $" · {entry.Decision.Team}")</strong><p>@entry.Decision.Tryout</p><p class="muted">@entry.Decision.Author · @entry.Decision.CreatedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</p>@if (entry.Decision.Reason.Length > 0) { <p class="note-text">@entry.Decision.Reason</p> }</li> }</ul>
        </section>
    }
</SportFrame>
