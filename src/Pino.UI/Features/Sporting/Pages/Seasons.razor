@page "/clubs/{ClubId:guid}/seasons"
@page "/clubs/{ClubId:guid}/seasons/{SeasonId:guid}"
@attribute [Authorize]
@rendermode InteractiveAuto
@layout ClubLayout
@inherits SportPageBase

<PageTitle>@(_selected?.Name ?? "Seasons & teams") · Pino</PageTitle>
<SportFrame Membership="Membership" Busy="Busy" Failed="Failed" Message="@Message" MessageKind="@MessageKind" Reload="ReloadAsync">
    @if (_selected is not null) { <p><a href="@($"/clubs/{ClubId}/seasons")">All seasons &amp; club teams</a></p> }
    <header class="sport-heading">
        <div><h1>@(_selected?.Name ?? "Seasons & teams")</h1><p>@(_selected is null ? "Club teams stay with you. Seasons keep each year's placements separate." : $"{_selected.StartsOn:MMM d, yyyy} – {_selected.EndsOn:MMM d, yyyy}")</p></div>
        @if (_selected is null) { <button class="primary-action" @onclick="NewSeason" disabled="@Disabled">Add season</button> }
        else { <button class="secondary-action" @onclick="EditSeason" disabled="@Disabled">@(_selected.Archived ? "Reopen or edit season" : "Edit season")</button> }
    </header>
    @if (_seasonInput is not null) { <section class="sport-edit"><h2>@(_seasonInput.Revision == 0 ? "New season" : "Edit season")</h2><SeasonEditor @key="_seasonInput" Input="_seasonInput" Save="SaveSeasonAsync" Cancel="CloseForms" Busy="Busy" /></section> }
    @if (_overview is { } overview)
    {
        @if (_selected is null)
        {
            @if (overview.Seasons.Count == 0) { <section class="sport-empty"><h2>Start your first season</h2><p>Set its dates, then create a tryout. Active club players and teams are included automatically.</p></section> }
            <ul class="record-list">
                @foreach (var season in overview.Seasons)
                {
                    <li class="record-row" @key="season.Id">
                        <div><h2><a href="@($"/clubs/{ClubId}/seasons/{season.Id}")">@season.Name</a></h2><p class="muted">@season.StartsOn.ToString("MMM d, yyyy") – @season.EndsOn.ToString("MMM d, yyyy")</p><span>@overview.Tryouts.Count(tryout => tryout.SeasonId == season.Id) tryouts</span></div>
                        <div class="record-actions"><span class="decision-badge" data-kind="@(season.Archived ? "withdrawn" : "awaiting")">@(season.Archived ? "Archived" : "Active season")</span><a class="secondary-action" href="@($"/clubs/{ClubId}/seasons/{season.Id}")">Open season</a></div>
                    </li>
                }
            </ul>
        }
        else if (_selected is { } selected)
        {
            <nav class="workflow-actions" aria-label="Season actions">
                <a class="secondary-action" href="@($"/clubs/{ClubId}/seasons/{SeasonId}/review")">Review season &amp; team rosters</a>
                @if (Membership?.Role == ClubRole.Administrator) { <a class="secondary-action" href="@($"/clubs/{ClubId}/seasons/{SeasonId}/teams")">Manage team availability</a> }
            </nav>
            @if (selected.Archived) { <p class="notice" data-kind="information">Archived season. Reopen it to change tryouts or placements.</p> }
            <section class="sport-section">
                <header class="sport-heading"><div><h2>Tryouts</h2><p>New tryouts include all active club players.</p></div><button class="primary-action" disabled="@(Disabled || selected.Archived)" @onclick="NewTryout">Add tryout</button></header>
                @if (_tryoutInput is not null) { <div class="sport-edit"><h3>@(_tryoutInput.Revision == 0 ? "New tryout" : "Edit tryout")</h3><TryoutEditor @key="_tryoutInput" Input="_tryoutInput" Save="SaveTryoutAsync" Cancel="CloseForms" Busy="Busy" /></div> }
                @if (!overview.Tryouts.Any(tryout => tryout.SeasonId == SeasonId)) { <p class="muted">Create a tryout to start evaluating. You can exclude players afterward.</p> }
                <ul class="record-list">
                    @foreach (var tryout in overview.Tryouts.Where(tryout => tryout.SeasonId == SeasonId))
                    {
                        <li class="record-row" @key="tryout.Id">
                            <div><h3>@tryout.Name</h3><p class="muted">@tryout.Date.ToString("MMM d, yyyy")@(tryout.Location.Length > 0 ? $" · {tryout.Location}" : "")</p><span class="decision-badge" data-kind="@SportLabels.ProgressKind(tryout)">@SportLabels.Progress(tryout)</span><span class="record-count">@tryout.Decided / @tryout.Players decisions</span></div>
                            <div class="record-actions"><a class="primary-action" href="@($"/clubs/{ClubId}/tryouts/{tryout.Id}")">@(tryout.Closed ? "View tryout" : "Open tryout")</a><button class="text-action" disabled="@(Disabled || selected.Archived || tryout.Closed)" @onclick="() => EditTryout(tryout)" aria-label="@($"Edit {tryout.Name}")">Edit details</button></div>
                        </li>
                    }
                </ul>
            </section>
        }
        <section class="sport-section">
            <header class="sport-heading"><div><h2>Club teams</h2><p>@(_selected is null ? "Create each team once. It is available in every season and tryout." : "Included by default. Exclusions affect new placements only.")</p></div><button class="secondary-action" disabled="@Disabled" @onclick="NewTeam">Add team</button></header>
            @if (_teamInput is not null) { <div class="sport-edit"><h3>@(_teamInput.Revision == 0 ? "New club team" : "Edit club team")</h3><p class="muted">Changes apply to this team across the club.</p><TeamEditor @key="_teamInput" Input="_teamInput" Save="SaveTeamAsync" Cancel="CloseForms" Busy="Busy" /></div> }
            @if (_teams.Count == 0) { <p class="muted">Add your club's teams and their graduation-year eligibility before making placements.</p> }
            <ul class="record-list">
                @foreach (var team in _teams)
                {
                    <li class="record-row" @key="team.Id">
                        <div><h3><a href="@TeamUrl(team.Id)">@team.Name</a></h3><p class="muted">Graduation @team.GraduationYear or later</p><span class="decision-badge" data-kind="@(team.Archived || team.Excluded ? "withdrawn" : "placed")">@SportLabels.TeamState(team)</span></div>
                        <div class="record-actions"><a class="secondary-action" href="@TeamUrl(team.Id)">View rosters</a><button class="text-action" disabled="@Disabled" @onclick="() => EditTeam(team)" aria-label="@($"Edit {team.Name}")">Edit team</button></div>
                    </li>
                }
            </ul>
        </section>
    }
</SportFrame>
