@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Pino.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

@if (_externalLogins.Length > 0)
{
    <h3>Or continue with</h3>
    <form action="Account/PerformExternalLogin" method="post">
        <div>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <div class="actions">
                @foreach (var provider in _externalLogins)
                {
                    <button class="secondary-action" type="submit" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                }
            </div>
        </div>
    </form>
}
