@page "/Account/LoginWithRecoveryCode"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Pino.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject AccountSignInService AccountSignIn
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<LoginWithRecoveryCode> Logger

<PageTitle>Recovery code verification</PageTitle>

<h1>Recovery code verification</h1>
<hr />
<StatusMessage Message="@_message" />
<p>
    Enter one of your saved recovery codes. Each code works once.
    This sign-in will not be remembered on this device. Next time, use an authenticator code
    or another unused recovery code.
</p>
<EditForm class="account-form" Model="Input" FormName="login-with-recovery-code" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator />
    <ValidationSummary class="error-text" role="alert" />
    <div class="form-field">
        <label for="Input.RecoveryCode">Recovery Code</label>
        <InputText @bind-Value="Input.RecoveryCode" id="Input.RecoveryCode" autocomplete="off" placeholder="RecoveryCode" />
        <ValidationMessage For="() => Input.RecoveryCode" class="error-text" />
    </div>
    <button class="primary-action" type="submit">Log in</button>
</EditForm>
