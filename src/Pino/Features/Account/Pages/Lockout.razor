@page "/Account/Lockout"

<PageTitle>Locked out</PageTitle>

<header>
    <h1 class="error-text">Locked out</h1>
    <p class="error-text" role="alert">Too many failed sign-in attempts. Wait 15 minutes before trying again.</p>
    <p><a href="/Account/ForgotPassword">Reset your password</a> if you have forgotten it, then return to sign in.</p>
</header>
