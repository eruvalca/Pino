@page "/Account/RegisterConfirmation"
@inject IdentityRedirectManager RedirectManager

<PageTitle>Check your email · Pino</PageTitle>
<h1>Check your email</h1>
<p role="status">Please check your email to confirm your account.</p>
<p>If the message hasn't arrived, check your spam folder. Wait at least a minute before you <a href="@ResendUrl">request another confirmation email</a>. Repeated requests are limited to six per hour.</p>
<p><a href="@SignInUrl">Back to sign in</a></p>
