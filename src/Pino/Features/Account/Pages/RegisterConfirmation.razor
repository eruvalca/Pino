@page "/Account/RegisterConfirmation"
@inject IdentityRedirectManager RedirectManager

<PageTitle>Check your email · Pino</PageTitle>
<h1>Check your email</h1>
<p role="status">Please check your email to confirm your account.</p>
<p>If the message hasn't arrived, check your spam folder or <a href="Account/ResendEmailConfirmation">request another confirmation email</a>.</p>
<p><a href="Account/Login">Back to sign in</a></p>
