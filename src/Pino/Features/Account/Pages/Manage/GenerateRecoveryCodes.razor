@page "/Account/Manage/GenerateRecoveryCodes"

@using Microsoft.AspNetCore.Identity
@using Pino.Data

@inject UserManager<ApplicationUser> UserManager
@inject AccountTwoFactorService AccountTwoFactor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<GenerateRecoveryCodes> Logger

<PageTitle>Generate two-factor authentication (2FA) recovery codes</PageTitle>

@if (_recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="_recoveryCodes" StatusMessage="@_message" />
}
else
{
    <StatusMessage Message="@_message" />
    <h2>Generate two-factor authentication (2FA) recovery codes</h2>
    <div class="notice" data-kind="warning" role="alert">
        <p>
            <strong>Put these codes in a safe place.</strong>
        </p>
        <p>
            If you lose your device and don't have the recovery codes you will lose access to your account.
        </p>
        <p>
            New recovery codes replace your old ones. Your authenticator app keeps working.
            To replace its setup, <a href="Account/Manage/ResetAuthenticator">reset your authenticator key</a>.
        </p>
    </div>
    <div>
        <form @formname="generate-recovery-codes" @onsubmit="OnSubmitAsync" method="post">
            <AntiforgeryToken />
            <button class="primary-action" type="submit">Generate Recovery Codes</button>
        </form>
    </div>
}
