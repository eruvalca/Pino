@page "/Account/Manage/Passkeys"

@using Pino.Data
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@using System.Buffers.Text

@inject UserManager<ApplicationUser> UserManager
@inject AccountPasskeyService AccountPasskeys
@inject IdentityRedirectManager RedirectManager

<PageTitle>Manage your passkeys</PageTitle>

<h2>Manage your passkeys</h2>

<StatusMessage />
<p>Passkeys let you sign in with your device's fingerprint, face recognition or screen lock. Keep another sign-in method available when removing one.</p>

@if (_currentPasskeys is { Count: > 0 })
{
    <div class="table-container">
        <table>
            <tbody>
                @foreach (var passkey in _currentPasskeys)
                {
                    <tr>
                        <td>@(passkey.Name ?? "Unnamed passkey")</td>
                        <td>
                            @{
                                var credentialId = Base64Url.EncodeToString(passkey.CredentialId);
                            }
                            <form @formname="@($"update-passkey-{credentialId}")" @onsubmit="UpdatePasskeyAsync" method="post">
                                <AntiforgeryToken />
                                <div class="actions">
                                    <input type="hidden" name="CredentialId" value="@credentialId" />
                                    <button class="secondary-action" type="submit" name="Action" value="rename" title="Rename this passkey">Rename</button>
                                    <details class="passkey-removal"><summary>Remove passkey</summary><p>Remove <strong>@(passkey.Name ?? "Unnamed passkey")</strong>? It will no longer sign in to Pino.</p><div class="actions"><button class="secondary-action" type="submit" name="Action" value="delete">Confirm removal</button><a class="text-action" href="Account/Manage/Passkeys">Keep passkey</a></div></details>
                                </div>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p>No passkeys added yet.</p>
}

<form @formname="add-passkey" @onsubmit="AddPasskeyAsync" method="post">
    <AntiforgeryToken />
    @if (_currentPasskeys is { Count: >= MaxPasskeyCount })
    {
        <p class="error-text">Your passkey list is full. Remove one before adding another.</p>
    }
    else
    {
        <PasskeySubmit Operation="PasskeyOperation.Create" Name="Input">Add a new passkey</PasskeySubmit>
    }

</form>
