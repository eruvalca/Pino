@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using Pino.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Personal Data</PageTitle>

<StatusMessage />
<h2>Personal Data</h2>

<p>Download your account information and club profile separately.</p>
<section class="account-data-section" aria-labelledby="download-data-heading"><h3 id="download-data-heading">Keep a copy</h3>
<form action="Account/Manage/DownloadPersonalData" method="post">
    <AntiforgeryToken />
    <button class="primary-action" type="submit">Download</button>
</form>
<p><a class="secondary-action" href="/api/clubs/personal-data" download>Download club profile, photo, and request history</a></p></section>
<section class="account-data-section" aria-labelledby="delete-data-heading"><h3 id="delete-data-heading">Delete your account</h3><p><strong>This permanently deletes your account. You cannot undo it.</strong></p><a class="secondary-action" href="Account/Manage/DeletePersonalData">Delete</a></section>
