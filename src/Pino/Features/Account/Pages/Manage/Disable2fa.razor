@page "/Account/Manage/Disable2fa"

@using Microsoft.AspNetCore.Identity
@using Pino.Data

@inject UserManager<ApplicationUser> UserManager
@inject AccountTwoFactorService AccountTwoFactor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<Disable2fa> Logger

<PageTitle>Disable two-factor authentication (2FA)</PageTitle>

<StatusMessage />
<h2>Disable two-factor authentication (2FA)</h2>

<div class="notice" data-kind="warning" role="alert">
    <p>
        <strong>You will no longer need an authenticator code when signing in with your password.</strong>
    </p>
    <p>
        Your authenticator setup stays saved. To replace it,
        <a href="Account/Manage/ResetAuthenticator">reset your authenticator key</a> instead.
    </p>
</div>

<div>
    <form @formname="disable-2fa" @onsubmit="OnSubmitAsync" method="post">
        <AntiforgeryToken />
        <button class="primary-action" type="submit">Disable 2FA</button>
    </form>
</div>
