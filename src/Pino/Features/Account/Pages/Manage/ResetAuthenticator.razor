@page "/Account/Manage/ResetAuthenticator"

@using Microsoft.AspNetCore.Identity
@using Pino.Data

@inject UserManager<ApplicationUser> UserManager
@inject AccountTwoFactorService AccountTwoFactor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ResetAuthenticator> Logger

<PageTitle>Reset authenticator key</PageTitle>

<StatusMessage />
<h2>Reset authenticator key</h2>
<div class="notice" data-kind="warning" role="alert">
    <p>
        <strong>After you reset the key, you must set up your authenticator app again before its codes will work.</strong>
    </p>
    <p>
        Resetting turns off two-factor authentication. Set up your authenticator app again to turn it back on.
    </p>
</div>
<div>
    <form @formname="reset-authenticator" @onsubmit="OnSubmitAsync" method="post">
        <AntiforgeryToken />
        <button class="primary-action" type="submit">Reset authenticator key</button>
    </form>
</div>
